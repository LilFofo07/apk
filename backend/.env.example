PORT=3000
NODE_ENV=development

# Conexão Banco de Dados PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rewards_db

# Segredo para autenticação JWT
JWT_SECRET=super_secret_jwt_key_32chars_long_min

# Chave secreta de Callback/Webhook SSV configurada na rede de anúncios (AppLovin / AdMob)
# No painel do AppLovin MAX: SDK Key / Event Callback Event Key
AD_NETWORK_SSV_SECRET=seu_segredo_ssv_adnetwork_aqui

# Configuração de Conversão
POINTS_PER_REWARD=100
COOLDOWN_SECONDS_BETWEEN_ADS=25
