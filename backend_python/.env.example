PORT=8000
ENVIRONMENT=development

# ====================================================================
# 1. SUPABASE (Banco de Dados na Nuvem - Gratuito)
# Pegue no painel do Supabase: Project Settings -> Database -> Connection String (URI / Pooler)
# Exemplo: postgres://postgres.SEU_PROJETO:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Se deixar em branco, o sistema utilizará um banco SQLite local para testes imediatos!
# ====================================================================
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# ====================================================================
# 2. MERCADO PAGO (API de PIX - Gratuita)
# Pegue em: https://www.mercadopago.com.br/developers/panel -> Suas Aplicações -> Credenciais de Teste
# Exemplo: TEST-1234567890-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# Se deixar em branco, o backend ativa o Simulador Realista de PIX do Mercado Pago!
# ====================================================================
MP_ACCESS_TOKEN=

# ====================================================================
# 3. SEGURANÇA E REGRAS DE NEGÓCIO
# ====================================================================
JWT_SECRET=super_secret_jwt_rewards_key_2026_xyz
AD_NETWORK_SSV_SECRET=sua_chave_secreta_webhook_applovin
COOLDOWN_SECONDS_BETWEEN_ADS=20
POINTS_PER_VIDEO=100
